{
  "scopes": {
    "global": ["format: yaml", "path: '$'"],
    "container": ["format: yaml", "path: '$.containers[*]'", "key: '$.name'"]
  },
  "cases": [
    {
      "name": "file grouping merges a file's scopes and keeps first-encounter order",
      "scope": "container",
      "included": ["**/*.yaml"],
      "filter": ["non_empty: '$.data.limits.memory'"],
      "decisionLines": ["group_by: file"],
      "compiled": { "group_by": "file" },
      "inputs": [
        {
          "filepath": "charts/z/values.yaml",
          "lines": ["containers:", "  - name: z-app", "    limits: {memory: 2Gi}", "  - name: z-side"]
        },
        {
          "filepath": "charts/a/values.yaml",
          "lines": ["containers:", "  - name: a-app", "    limits: {memory: 1Gi}"]
        },
        {
          "filepath": "charts/z/values.yaml",
          "lines": ["containers:", "  - name: z-late", "    limits: {memory: 3Gi}"]
        }
      ],
      "expected": {
        "groups": [
          {
            "group": { "type": "file", "path": "charts/z/values.yaml" },
            "files": [
              {
                "filepath": "charts/z/values.yaml",
                "scopes": [
                  { "id": "0:z-app", "data": { "name": "z-app", "limits": { "memory": "2Gi" } } },
                  { "id": "0:z-late", "data": { "name": "z-late", "limits": { "memory": "3Gi" } } }
                ]
              }
            ]
          },
          {
            "group": { "type": "file", "path": "charts/a/values.yaml" },
            "files": [
              {
                "filepath": "charts/a/values.yaml",
                "scopes": [{ "id": "0:a-app", "data": { "name": "a-app", "limits": { "memory": "1Gi" } } }]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "folder grouping at level zero keeps one group per containing directory",
      "scope": "global",
      "included": ["**/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: folder"],
      "compiled": { "group_by": "folder", "level": 0 },
      "inputs": [
        { "filepath": "charts/app/values.yaml", "lines": ["name: app"] },
        { "filepath": "charts/lib/values.yaml", "lines": ["name: lib"] },
        { "filepath": "top.yaml", "lines": ["name: top"] }
      ],
      "expected": {
        "groups": [
          {
            "group": { "type": "folder", "path": "charts/app" },
            "files": [{ "filepath": "charts/app/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "app" } }] }]
          },
          {
            "group": { "type": "folder", "path": "charts/lib" },
            "files": [{ "filepath": "charts/lib/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "lib" } }] }]
          },
          {
            "group": { "type": "folder", "path": "." },
            "files": [{ "filepath": "top.yaml", "scopes": [{ "id": "0:", "data": { "name": "top" } }] }]
          }
        ]
      }
    },
    {
      "name": "folder grouping one level up merges sibling directories",
      "scope": "global",
      "included": ["**/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: folder", "level: -1"],
      "compiled": { "group_by": "folder", "level": -1 },
      "inputs": [
        { "filepath": "charts/app/values.yaml", "lines": ["name: app"] },
        { "filepath": "charts/lib/values.yaml", "lines": ["name: lib"] },
        { "filepath": "top.yaml", "lines": ["name: top"] }
      ],
      "expected": {
        "groups": [
          {
            "group": { "type": "folder", "path": "charts" },
            "files": [
              { "filepath": "charts/app/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "app" } }] },
              { "filepath": "charts/lib/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "lib" } }] }
            ]
          },
          {
            "group": { "type": "folder", "path": "." },
            "files": [{ "filepath": "top.yaml", "scopes": [{ "id": "0:", "data": { "name": "top" } }] }]
          }
        ]
      }
    },
    {
      "name": "folder grouping two levels up clamps at the project root",
      "scope": "global",
      "included": ["**/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: folder", "level: -2"],
      "compiled": { "group_by": "folder", "level": -2 },
      "inputs": [
        { "filepath": "charts/app/values.yaml", "lines": ["name: app"] },
        { "filepath": "charts/lib/deep/values.yaml", "lines": ["name: deep"] },
        { "filepath": "top.yaml", "lines": ["name: top"] }
      ],
      "expected": {
        "groups": [
          {
            "group": { "type": "folder", "path": "." },
            "files": [
              { "filepath": "charts/app/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "app" } }] },
              { "filepath": "top.yaml", "scopes": [{ "id": "0:", "data": { "name": "top" } }] }
            ]
          },
          {
            "group": { "type": "folder", "path": "charts" },
            "files": [{ "filepath": "charts/lib/deep/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "deep" } }] }]
          }
        ]
      }
    },
    {
      "name": "folder grouping far above the root clamps every file to the project",
      "scope": "global",
      "included": ["**/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: folder", "level: -9"],
      "compiled": { "group_by": "folder", "level": -9 },
      "inputs": [
        { "filepath": "a/b/c/d.yaml", "lines": ["name: nested"] },
        { "filepath": "e/values.yaml", "lines": ["name: shallow"] }
      ],
      "expected": {
        "groups": [
          {
            "group": { "type": "folder", "path": "." },
            "files": [
              { "filepath": "a/b/c/d.yaml", "scopes": [{ "id": "0:", "data": { "name": "nested" } }] },
              { "filepath": "e/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "shallow" } }] }
            ]
          }
        ]
      }
    },
    {
      "name": "project grouping covers every directory as the project root",
      "scope": "global",
      "included": ["**/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: project"],
      "compiled": { "group_by": "project" },
      "inputs": [
        { "filepath": "services/api/values.yaml", "lines": ["name: api"] },
        { "filepath": "top.yaml", "lines": ["name: top"] },
        { "filepath": "services/web/values.yaml", "lines": ["name: web"] }
      ],
      "expected": {
        "groups": [
          {
            "group": { "type": "project", "path": "." },
            "files": [
              { "filepath": "services/api/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "api" } }] },
              { "filepath": "top.yaml", "scopes": [{ "id": "0:", "data": { "name": "top" } }] },
              { "filepath": "services/web/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "web" } }] }
            ]
          }
        ]
      }
    },
    {
      "name": "a rule that names no decision keeps one context per scope in encounter order",
      "scope": "global",
      "included": ["**/*.yaml"],
      "filter": null,
      "decisionLines": null,
      "compiled": { "group_by": "scope" },
      "inputs": [
        { "filepath": "b.yaml", "lines": ["name: beta"] },
        { "filepath": "a.yaml", "lines": ["name: alpha"] }
      ],
      "expected": {
        "contexts": [
          { "filepath": "b.yaml", "scope": { "id": "0:", "data": { "name": "beta" } } },
          { "filepath": "a.yaml", "scope": { "id": "0:", "data": { "name": "alpha" } } }
        ]
      }
    },
    {
      "name": "a filter that rejects every scope groups nothing",
      "scope": "container",
      "included": ["**/*.yaml"],
      "filter": ["non_empty: '$.data.limits.memory'"],
      "decisionLines": ["group_by: file"],
      "compiled": { "group_by": "file" },
      "inputs": [
        {
          "filepath": "charts/app/values.yaml",
          "lines": ["containers:", "  - name: app", "  - name: side"]
        }
      ],
      "expected": { "groups": [] }
    },
    {
      "name": "folder grouping rejects a source outside the project root",
      "scope": "global",
      "included": ["../outside/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: folder"],
      "compiled": { "group_by": "folder", "level": 0 },
      "inputs": [{ "filepath": "../outside/values.yaml", "lines": ["name: outside"] }],
      "expected": { "error": "group" }
    },
    {
      "name": "project grouping rejects a source outside the project root",
      "scope": "global",
      "included": ["../outside/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: project"],
      "compiled": { "group_by": "project" },
      "inputs": [{ "filepath": "../outside/values.yaml", "lines": ["name: outside"] }],
      "expected": { "error": "group" }
    },
    {
      "name": "file grouping keeps a source outside the project root under its own path",
      "scope": "global",
      "included": ["../outside/*.yaml"],
      "filter": null,
      "decisionLines": ["group_by: file"],
      "compiled": { "group_by": "file" },
      "inputs": [{ "filepath": "../outside/values.yaml", "lines": ["name: outside"] }],
      "expected": {
        "groups": [
          {
            "group": { "type": "file", "path": "../outside/values.yaml" },
            "files": [{ "filepath": "../outside/values.yaml", "scopes": [{ "id": "0:", "data": { "name": "outside" } }] }]
          }
        ]
      }
    }
  ]
}
