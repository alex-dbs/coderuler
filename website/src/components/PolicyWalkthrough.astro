---
import { Code } from 'astro:components';
import Violation from './Violation.astro';
import RuleCode from './RuleCode.astro';
import '../styles/walkthrough.css';

import appendSliceRuleSource from '../../../.coderuler.examples/go-append-slice.rule.ts?raw';

const policy = appendSliceRuleSource
  .split('\nexport const aiTests')[0]
  .replace(', test', '')
  .replace(/    examples: \{[\s\S]*?^    \},\n/m, '')
  .trim();
const source = `package store

func growScores(scores []int) []int {
    out := make([]int, 0, len(scores))
    for _, score := range scores {
        out = append(out, score)
    }
    return out
}`;
const command = 'coderuler check';
---
<section class="policy-walkthrough page-shell" id="how-it-works" aria-labelledby="walkthrough-heading">
  <div class="walkthrough-layout">
    <div class="walkthrough-explanation">
      <h2 id="walkthrough-heading">How it works</h2>
      <div class="walkthrough-intent">
        <p class="walkthrough-label">Policy intent</p>
        <blockquote>When the output count is known, allocate the slice at its final length.</blockquote>
      </div>

      <p class="walkthrough-label">Steps</p>
      <ol class="walkthrough-steps">
        <li>
          <h3>Choose the files.</h3>
          <p>The <code>**/*.go</code> pattern selects Go files, including <code>internal/store/scores.go</code> below.</p>
        </li>
        <li>
          <h3>Select candidate functions.</h3>
          <p>The selector finds functions and methods with a <code>for</code> loop that contains <code>append</code>. The AI checks each match.</p>
        </li>
        <li>
          <h3>Check the selected function.</h3>
          <p>The AI receives the selected function. It can compare the loop's output count with the slice length and decide whether to fill the slice directly.</p>
        </li>
      </ol>
      <p class="walkthrough-run-note">Run from your repository root:</p>
      <div class="walkthrough-command">
        <Code code={command} lang="bash" theme="material-theme-palenight" />
      </div>
    </div>

    <div class="walkthrough-example">
      <RuleCode code={policy} filename=".coderuler.examples/go-append-slice.rule.ts" class="walkthrough-policy-code">
        <a slot="footer" class="rule-source-link" href="https://github.com/alex-dbs/coderuler/blob/main/.coderuler.examples/go-append-slice.rule.ts">Read the full source policy <span aria-hidden="true">↗</span></a>
      </RuleCode>

      <Violation
        rule="go-append-slice"
        file="internal/store/scores.go"
        message="For this known-size loop, allocate the final length and fill by index."
        source={source}
        startLine={1}
        highlightLine={6}
      />
    </div>
  </div>
</section>
