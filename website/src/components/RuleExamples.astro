---
import RuleCode from './RuleCode.astro';
import goRuleSource from '../../../.coderuler/go-dereference-guard.rule.ts?raw';
import goAppRuleSource from '../../../.coderuler/go-app-no-infrastructure.rule.ts?raw';
import serviceRuleSource from '../../../.coderuler/service-proto.rule.ts?raw';
import jsonSchemaRuleSource from '../../../.coderuler/json-schema-config.rule.ts?raw';
import Violation from './Violation.astro';
import { sitePath } from '../lib/paths';
import '../styles/rule-examples.css';

const source = 'https://github.com/alex-dbs/coderuler/blob/main/.coderuler/';
const sourceDirectory = 'https://github.com/alex-dbs/coderuler/tree/main/.coderuler/';
const httpRule = `import { Rule, ai, scopes } from '@alex-dbs/coderuler';

export default class HttpResponseSplitting extends Rule {
  files = ['tests/manual/vulnerable_code.js'];
  scope = scopes.astGrep({
    language: 'javascript',
    rule: {
      any: [
        { kind: 'function_declaration' },
        { kind: 'function_expression' },
        { kind: 'arrow_function' },
        { kind: 'method_definition' },
      ],
    },
  });

  check = ai({
    // Abridged prompt. Full policy and tests in the source.
    instruction: \`Reject CR and LF in untrusted values before
inserting them into HTTP response headers or status lines.
This policy covers construction and writes visible in the selected
function. Hidden helper behavior and unseen callers are outside its
scope. Treat serialization arguments and statusMessage as untrusted.
Fixed values and values checked for both CR and LF meet this
requirement. Preserve fixed HTTP delimiters.\`,
    violationMessage: 'Reject CR and LF in attacker-controlled response headers and status messages before writing them.',
  });
}`;

const vulnerableResponse = String.raw`export function respond(request, socket) {
  const name = new URL(request.url, 'http://localhost').searchParams.get('name');
  socket.write('HTTP/1.1 200 OK\r\nX-Name: ' + name + '\r\n\r\n');
}`;

const goRule = goRuleSource
  .split('\nexport const aiTests')[0]
  .replace(', test, type ScopeSubject', '')
  .replace(/    examples: \{[\s\S]*?^    \},\n/m, '')
  .replace(/    input: async \(subject, \{ project \}\) => \{[\s\S]*?^    \},\n/m, '')
  .trim();

const goAppRule = goAppRuleSource
  .split('\nexport const aiTests')[0]
  .replace(', test, type ScopeSubject', '')
  .replace(/    examples: \{[\s\S]*?^    \},\n/m, '')
  .replace(/    input: async \(subject, \{ project \}\) => \{[\s\S]*?^    \},\n/m, '')
  .trim();

const serviceRule = serviceRuleSource.split('\nfunction proto')[0].trim();
const jsonSchemaRule = jsonSchemaRuleSource.split('\nexport const tests')[0].trim();
const invalidConfig = `{
  "port": "8080"
}`;
const nestedPointer = `type Config struct { Child *Child }
type Child struct { Value *int }

func nestedValue(config *Config) int {
    if config == nil {
        return 0
    }
    return *(*config).Child.Value
}`;
const serviceProto = `syntax = "proto3";
import "google/api/annotations.proto";
package acme.billing.v1;
message Request {}
message Response {}
service BillingService {
  rpc ListInvoices(Request) returns (Response) {
    option (google.api.http) = {
      get: "/v1/invoices"
    };
  }
}`;

const goAppQuery = `package app

import (
    "context"
    "database/sql"
)

type Account struct { ID string }

func Find(ctx context.Context, db *sql.DB, id string) (Account, error) {
    var account Account
    err := db.QueryRowContext(ctx, "SELECT id FROM accounts WHERE id = ?", id).Scan(&account.ID)
    return account, err
}`;

---
<section class="rule-examples page-shell" id="examples" aria-labelledby="rule-examples-title" data-rule-tabs>
  <header class="rule-examples-heading">
    <div>
      <h2 id="rule-examples-title">Some ideas for you…</h2>
      <div class="rule-example-links">
        <a href={sourceDirectory} aria-label="Read all examples">Read all examples <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <p>See how rules enforce policies in code and configuration.</p>
  </header>

  <div class="rule-example-tabs" role="tablist" aria-label="Repository rule examples" data-rule-tablist hidden>
    <button id="rule-tab-http" type="button" role="tab" aria-selected="true" aria-controls="rule-panel-http" tabindex="0" data-rule-tab>Security</button>
    <button id="rule-tab-go-app" type="button" role="tab" aria-selected="false" aria-controls="rule-panel-go-app" tabindex="-1" data-rule-tab>Architecture</button>
    <button id="rule-tab-go" type="button" role="tab" aria-selected="false" aria-controls="rule-panel-go" tabindex="-1" data-rule-tab>Bug finding</button>
    <button id="rule-tab-service" type="button" role="tab" aria-selected="false" aria-controls="rule-panel-service" tabindex="-1" data-rule-tab>Conventions</button>
    <button id="rule-tab-json-schema" type="button" role="tab" aria-selected="false" aria-controls="rule-panel-json-schema" tabindex="-1" data-rule-tab>Configuration</button>
  </div>

  <article id="rule-panel-http" class="rule-example" aria-labelledby="http-example-title" data-rule-example="http" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="http-example-title">Prevent unsafe HTTP responses.</h3>
      <p class="rule-example-timing"><strong>131<span>ms</span></strong><span>to catch CWE-113: HTTP response splitting<br />at a cost of $0.0002</span></p>
      <Violation
        rule="http-response-splitting"
        file="tests/manual/vulnerable_code.js"
        message="Reject CR and LF in attacker-controlled response headers and status messages before writing them."
        source={vulnerableResponse}
        highlightLine={3}
      />
      <div class="rule-example-links">
        <a href={sitePath('/docs/ai-checks/')}>How AI checks work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <RuleCode code={httpRule} filename="http-response-splitting.rule.ts" class="rule-example-code">
      <a slot="footer" class="rule-source-link" href={`${source}http-response-splitting.rule.ts`}>Read the full source policy <span aria-hidden="true">↗</span></a>
    </RuleCode>
  </article>

  <article id="rule-panel-go-app" class="rule-example" aria-labelledby="go-app-example-title" data-rule-example="go-app" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="go-app-example-title">Ensure hexagonal architecture is respected.</h3>
      <p>This function queries SQL through a concrete <code>*sql.DB</code> client inside <code>internal/app</code>.</p>
      <p>Call a port from the application layer. Keep the SQL query in the adapter.</p>
      <Violation
        rule="go-app-no-infrastructure"
        file="internal/app/account/query.go"
        message="Move infrastructure I/O out of the domain and call an injected port instead."
        source={goAppQuery}
        highlightLine={12}
      />
    </div>
    <RuleCode code={goAppRule} filename="go-app-no-infrastructure.rule.ts" class="rule-example-code" aria-label="Go application architecture rule excerpt">
      <a slot="footer" class="rule-source-link" href={`${source}go-app-no-infrastructure.rule.ts`}>Read the full source policy <span aria-hidden="true">↗</span></a>
    </RuleCode>
  </article>

  <article id="rule-panel-go" class="rule-example" aria-labelledby="go-example-title" data-rule-example="go" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="go-example-title">Go pointer dereferences need nil checks.</h3>
      <p>The code checks <code>config</code> for nil, but it does not check nested pointers <code>Child</code> or <code>Value</code>. This can cause nil pointer errors.</p>
      <Violation
        rule="go-dereference-guard"
        file="internal/store/config.go"
        message="Check each pointer for nil before using *."
        source={nestedPointer}
        startLine={1}
        highlightLine={8}
      />
    </div>
    <RuleCode code={goRule} filename="go-dereference-guard.rule.ts" class="rule-example-code" aria-label="Go dereference rule excerpt">
      <a slot="footer" class="rule-source-link" href={`${source}go-dereference-guard.rule.ts`}>Read the full source policy <span aria-hidden="true">↗</span></a>
    </RuleCode>
  </article>

  <article id="rule-panel-service" class="rule-example" aria-labelledby="service-example-title" data-rule-example="service" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="service-example-title">Ensure conventions are followed.</h3>
      <p>This rule selects HTTP option values in internal Protobuf files. Each URL must use the <code>/service/vN/</code> prefix. Optional subpaths are allowed.</p>
      <p>The selected URL, <code>/v1/invoices</code>, is missing <code>/service</code>.</p>
      <Violation
        rule="service-proto"
        file="tests/manual/proto/internal/service.proto"
        message="Service endpoints must start with a /service/vX/ ."
        source={serviceProto}
        highlightLine={9}
      />
    </div>
    <RuleCode code={serviceRule} filename="service-proto.rule.ts" class="rule-example-code">
      <a slot="footer" class="rule-source-link" href={`${source}service-proto.rule.ts`}>Read the full source policy <span aria-hidden="true">↗</span></a>
    </RuleCode>
  </article>
  <article id="rule-panel-json-schema" class="rule-example" aria-labelledby="json-schema-example-title" data-rule-example="json-schema" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="json-schema-example-title">Validate JSON against a schema.</h3>
      <p>This rule uses plain code and the Ajv dependency to check each config file against a JSON Schema.</p>
      <p>The value <code>"8080"</code> is a string, so it does not match the schema's integer requirement.</p>
      <Violation
        rule="json-schema-config"
        file="config/app.json"
        message="/port: must be integer"
        source={invalidConfig}
        highlightLine={2}
      />
      <div class="rule-example-links">
        <a href={sitePath('/docs/dependencies/')}>Manage rule dependencies <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <RuleCode code={jsonSchemaRule} filename="json-schema-config.rule.ts" class="rule-example-code">
      <a slot="footer" class="rule-source-link" href={`${source}json-schema-config.rule.ts`}>Read the full source policy <span aria-hidden="true">↗</span></a>
    </RuleCode>
  </article>
</section>

<script>
  import '../scripts/rule-tabs';
</script>
