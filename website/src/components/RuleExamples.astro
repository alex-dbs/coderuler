---
import RuleCode from './RuleCode.astro';
import goRuleSource from '../../../.rulekeeper/go-append-slice.rule.ts?raw';
import serviceRuleSource from '../../../.rulekeeper/service-proto.rule.ts?raw';
import Violation from './Violation.astro';
import '../styles/rule-examples.css';

const source = 'https://github.com/alex-dbs/rulekeeper/blob/main/.rulekeeper/';
const httpRule = `import { Rule, ai, scopes } from '@alex-dbs/rulekeeper';

export default class HttpResponseSplitting extends Rule {
  files = ['tests/manual/vulnerable_code.js'];
  scope = scopes.astGrep({
    language: 'javascript',
    rule: {
      any: [
        { kind: 'function_declaration' },
        { kind: 'function_expression' },
        { kind: 'arrow_function' },
        { kind: 'method_definition' },
      ],
    },
  });

  check = ai({
    // Abridged prompt. Full policy and tests in the source.
    rule: \`Assess only the supplied function scope.
Treat HTTP serialization entry-point arguments and
statusMessage as potentially untrusted. Report only visible
construction or writing of response headers or a status
line using such data without rejecting both CR and LF.
Do not assume unseen callers or helpers validate it.
A helper call alone is not evidence. Fixed values and
paths that reject both CR and LF before use comply.\`,
    violationMessage: 'Reject CR and LF in attacker-controlled response headers and status messages before writing them.',
  });
}`;

const vulnerableResponse = String.raw`export function respond(request, socket) {
  const name = new URL(request.url, 'http://localhost').searchParams.get('name');
  socket.write('HTTP/1.1 200 OK\r\nX-Name: ' + name + '\r\n\r\n');
}`;

const goRule = goRuleSource.split('\nexport const aiTests')[0].trim();
const serviceRule = serviceRuleSource.split('\nfunction proto')[0].trim();
const growScores = `func growScores(scores []int) []int {
    out := make([]int, 0, len(scores))
    for _, score := range scores {
        out = append(out, score)
    }
    return out
}`;
const serviceProto = `syntax = "proto3";
import "google/api/annotations.proto";
package acme.billing.v1;
message Request {}
message Response {}
service BillingService {
  rpc ListInvoices(Request) returns (Response) {
    option (google.api.http) = {
      get: "/v1/invoices"
    };
  }
}`;
---

<section class="rule-examples page-shell" id="examples" aria-labelledby="rule-examples-title" data-rule-tabs>
  <header class="rule-examples-heading">
    <h2 id="rule-examples-title">Some ideas for you…</h2>
    <p>See how these rules find unsafe code and enforce project conventions.</p>
  </header>

  <div class="rule-example-tabs" role="tablist" aria-label="Repository rule examples" data-rule-tablist hidden>
    <button id="rule-tab-http" type="button" role="tab" aria-selected="true" aria-controls="rule-panel-http" tabindex="0" data-rule-tab>Security</button>
    <button id="rule-tab-go" type="button" role="tab" aria-selected="false" aria-controls="rule-panel-go" tabindex="-1" data-rule-tab>Go slices</button>
    <button id="rule-tab-service" type="button" role="tab" aria-selected="false" aria-controls="rule-panel-service" tabindex="-1" data-rule-tab>API conventions</button>
  </div>

  <article id="rule-panel-http" class="rule-example" aria-labelledby="http-example-title" data-rule-example="http" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="http-example-title">Find unsafe HTTP responses.</h3>
      <p class="rule-example-timing"><strong>131<span>ms</span></strong><span>to catch a security issue<br />at a cost of $0.0002</span></p>
      <Violation
        rule="http-response-splitting"
        file="tests/manual/vulnerable_code.js"
        message="Reject CR and LF in attacker-controlled response headers and status messages before writing them."
        source={vulnerableResponse}
        highlightLine={3}
      />
      <div class="rule-example-links">
        <a href={`${source}http-response-splitting.rule.ts`}>Full HTTP rule and tests <span aria-hidden="true">↗</span></a>
        <a href="/docs/ai-checks/">How AI checks work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <RuleCode code={httpRule} filename="http-response-splitting.rule.ts" class="rule-example-code" />
  </article>

  <article id="rule-panel-go" class="rule-example" aria-labelledby="go-example-title" data-rule-example="go" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="go-example-title">Allocate the known slice length.</h3>
      <p>This function copies every score, so the final count is known. Reserving capacity still leaves the slice empty.</p>
      <p>The rule reports <code>append</code> here. Allocate <code>len(scores)</code> elements and fill them by index instead.</p>
      <Violation
        rule="go-append-slice"
        file="internal/store/scores.go"
        message="Allocate the known final length and fill by index instead of appending."
        source={growScores}
        startLine={12}
        highlightLine={15}
      />
      <div class="rule-example-links">
        <a href={`${source}go-append-slice.rule.ts`}>Full Go rule and tests <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <RuleCode code={goRule} filename="go-append-slice.rule.ts" class="rule-example-code" />
  </article>

  <article id="rule-panel-service" class="rule-example" aria-labelledby="service-example-title" data-rule-example="service" data-rule-panel>
    <div class="rule-example-copy">
      <h3 id="service-example-title">Keep the service prefix.</h3>
      <p>This rule selects HTTP binding URLs in internal Protobuf files. Each URL must match <code>/service/vN/plural_resource</code>, with optional subpaths.</p>
      <p>The selected URL, <code>/v1/invoices</code>, is missing <code>/service</code>.</p>
      <Violation
        rule="service-proto"
        file="tests/manual/proto/internal/service.proto"
        message="Service endpoints must start with a /service/vX/ ."
        source={serviceProto}
        highlightLine={9}
      />
      <div class="rule-example-links">
        <a href={`${source}service-proto.rule.ts`}>Full API rule and tests <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <RuleCode code={serviceRule} filename="service-proto.rule.ts" class="rule-example-code" />
  </article>
</section>

<script>
  import '../scripts/rule-tabs';
</script>
