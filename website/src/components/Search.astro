<dialog class="search-dialog" id="docs-search" aria-labelledby="search-title">
  <div class="search-dialog-heading">
    <h2 id="search-title">Search documentation</h2>
    <form method="dialog"><button class="icon-button" aria-label="Close search" type="submit">Esc</button></form>
  </div>
  <label class="sr-only" for="search-input">Search the CodeRuler documentation</label>
  <input id="search-input" type="search" placeholder="Search rules, commands, scopes…" autocomplete="off" spellcheck="false" />
  <p id="search-status" class="search-status" role="status" aria-live="polite" aria-atomic="true">Type to search the documentation.</p>
  <ul id="search-results" class="search-results" aria-label="Search results"></ul>
  <p class="search-hint">Search stays in your browser. <span>Tab to browse · Enter to open</span></p>
</dialog>
