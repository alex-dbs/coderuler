---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · RuleKeeper" description="Find the RuleKeeper documentation or return to the homepage.">
  <main id="main" class="not-found page-shell" tabindex="-1">
    <p class="eyebrow">404 / Page not found</p>
    <h1>This rule does not exist.</h1>
    <p>The page moved, or the address is incorrect.</p>
    <a class="button" href="/docs/">Open the documentation <span aria-hidden="true">↗</span></a>
    <a href="/">Back to the homepage</a>
  </main>
</Base>
