---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PolicyWalkthrough from '../components/PolicyWalkthrough.astro';
import RuleExamples from '../components/RuleExamples.astro';
import RuleWorkflow from '../components/RuleWorkflow.astro';
import { sitePath } from '../lib/paths';
import '../styles/home.css';

const install = 'npm install -g @alex-dbs/coderuler';
---
<Base title="CodeRuler — Your code. Your rules." description="Your AI agent can forget instructions and conventions. CodeRuler never forgets the rules you save. Run repository checks before review." page="home">
  <main id="main" class="home-page" tabindex="-1">
    <section class="home-hero page-shell" aria-labelledby="hero-title">
      <div class="home-hero-copy">
        <p class="eyebrow home-hero-eyebrow"><span class="home-tiny-square" aria-hidden="true"></span>Policy as code</p>
        <h1 id="hero-title">Your code.<br />Your <em>rules.</em></h1>
        <p class="home-hero-description">Your AI agent can forget instructions and conventions. CodeRuler never forgets the rules you save.</p>
        <div class="home-hero-actions">
          <a class="button" href={sitePath('/docs/quickstart/')}>Start building rules <span aria-hidden="true">↗</span></a>
          <a class="home-text-link" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
        </div>
        <button class="home-install-command" data-copy={install} aria-label="Copy npm install command" type="button">
          <span class="home-prompt" aria-hidden="true">$</span>
          <code>{install}</code>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 7h9v10H7zM4 13H2V2h10v2" stroke="currentColor" stroke-width="1.3" /></svg><span class="sr-only" data-copy-label>Copy</span>
        </button>
      </div>
      <Hero />
    </section>

    <PolicyWalkthrough />

    <RuleWorkflow />

    <RuleExamples />

    <section class="home-closing page-shell" aria-labelledby="closing-title">
      <p class="eyebrow">Get started</p>
      <div><h2 id="closing-title">Run your rules<br />before <em>review.</em></h2><div class="home-closing-actions"><a class="button" href={sitePath('/docs/quickstart/')}>Write your first rule <span aria-hidden="true">↗</span></a></div></div>
      <p class="home-closing-description">Save time and review costs by automating convention checks first. Let your frontier AI model focus on the code, without asking it to check every detail of your conventions.</p>
    </section>
  </main>
</Base>
<script>
  import '../scripts/hero';
</script>
