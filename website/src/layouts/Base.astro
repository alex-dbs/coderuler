---
import Search from '../components/Search.astro';
import { sitePath } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  page?: 'home' | 'docs';
}
const { title, description, page = 'home' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101017" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RuleKeeper" />
    <meta name="twitter:card" content="summary" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(sitePath('/rulekeeper-icon.webp'), Astro.site)} />}
    <link rel="icon" href={sitePath('/rulekeeper-icon.webp')} type="image/webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class={page}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header page-shell">
      <a class="wordmark" href={sitePath('/')} aria-label="RuleKeeper home">
        <img src={sitePath('/rulekeeper-icon.webp')} width="32" height="32" alt="" />
        RuleKeeper<span aria-hidden="true">.</span>
      </a>
      <nav class="header-nav" aria-label="Main navigation">
        <button class="search-trigger" type="button" data-search-open hidden aria-label="Search documentation">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
          <span class="search-trigger-text">Search docs</span><kbd aria-hidden="true">⌘ K</kbd>
        </button>
        <a href={sitePath('/docs/')} aria-current={page === 'docs' ? 'page' : undefined}>Docs</a>
        <a class="github-link" href="https://github.com/alex-dbs/rulekeeper" aria-label="RuleKeeper on GitHub">
          <svg class="github-icon" viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
          <span>GitHub</span>
        </a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer page-shell">
      <a href={sitePath('/')} class="footer-brand">RuleKeeper<span aria-hidden="true">.</span></a>
      <p>Policy as code.</p>
      <div><a href="https://alex-db.dev">By Alex Dubois <span aria-hidden="true">↗</span></a></div>
    </footer>
    <Search />
    <div class="sr-only" role="status" aria-live="polite" id="copy-status"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
