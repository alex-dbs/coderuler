{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.mts"],
  "exclude": ["old", "dist", "coverage", "node_modules"]
}
